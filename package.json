{
  "name": "taskfollow",
  "version": "0.1.0",
  "description": "A thin layer on the AI agent you already have: step-by-step setup, workflows with a person's approval, and honest feedback on what your agent can do",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appleaa123/installer.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "taskfollow": "dist/cli.js"
  },
  "files": [
    "dist",
    "relay",
    "profiles",
    "connectors",
    "solutions",
    "INSTALL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:live": "INSTALLER_LIVE=1 vitest run",
    "certify": "npm run build && node dist/cli.js certify"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
