{
  "name": "installer",
  "version": "0.1.0",
  "private": true,
  "description": "Generic agent-operated installer for Skills Wiki solutions",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "installer": "dist/cli.js"
  },
  "files": [
    "dist",
    "profiles",
    "connectors",
    "solutions",
    "INSTALL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:live": "INSTALLER_LIVE=1 vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
