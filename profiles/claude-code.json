{
  "id": "claude-code",
  "name": "Claude Code",
  "min_version": "2.1.0",
  "detect": { "cmd": ["claude", "--version"], "match": "Claude Code" },
  "headless": {
    "cmd": ["claude", "-p", "{prompt}", "--output-format", "json"],
    "result_path": "result",
    "session_path": "session_id",
    "error_path": "is_error",
    "no_persist": ["--no-session-persistence"],
    "tools_off": ["--tools", "", "--strict-mcp-config"],
    "allow_tool": ["--allowedTools", "{tool}"]
  },
  "schema": { "flag": ["--json-schema", "{schema_json}"], "result_path": "structured_output" },
  "resume": { "flag": ["-r", "{session_id}"] },
  "mcp_register": { "cmd": ["claude", "mcp", "add-json", "-s", "user", "{name}", "{config_json}"] },
  "mcp_remove": { "cmd": ["claude", "mcp", "remove", "-s", "user", "{name}"] },
  "task": { "min_version": "2.1.295", "cmd": ["claude", "-p", "{prompt}", "--output-format", "json", "--restricted", "--permission-prompts", "none", "--permission-mode", "manual", "--tools", "{tools}", "--allowedTools", "{may_use}", "--settings", "{settings_json}", "--mcp-config", "{mcp_config}", "--no-session-persistence"] },
  "asks": { "cmd": ["claude", "-p", "{prompt}", "--output-format", "json", "--permission-prompts", "none", "--no-session-persistence"], "min_version": "2.1.259" },
  "personal_settings": "claude",
  "skills_dirs": { "project": ".claude/skills", "user": "~/.claude/skills" },
  "instructions_file": "CLAUDE.md",
  "push": { "note": "Claude Code Channels is a research preview: it needs --channels, an approved plugin and an open chat window; see code.claude.com/docs/en/channels", "read": "2026-10-16" },
  "tos_review": { "status": "ok", "note": "First-party CLI used headless by the client on their own account." }
}
